3. gunzip dds2-alpine.flag.img.gz
4. mmls dds2-alpine.flag.img
5. fls -o 2048 dds2-alpine.flag.img
6. fls -o 2048 dds2-alpine.flag.img 18290
7. icat -o 2048 dds2-alpine.flag.img 18291

```

