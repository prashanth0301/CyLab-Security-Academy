# RSA low-exponent attack: e = 3

c = 

def integer_cube_root(n):
    low = 0
    high = 1 <<((n.bit_length() + 2) // 3)

    while low + 1 < high:
        mid = (low + high) // 2

        if mid ** 3 <= n:
            low = mid
        else:
            high = mid

    return low

# Recover the plaintext integer
m = integer_cube_root(c)

# Confirm the attack worked
if m ** 3 == c:
    print("[+] Exact cube root found!")

    # Convert integer to bytes
    raw = m.to_bytes((m.bit_length() + 7) // 8, "big")
    text = raw.decode("utf-8")

    print("[+] Decrypted plaintext:")
    print(repr(text))

    # Extract the flag
    start = text.find("academy{")
    end = text.find("}", start)

    if start != -1 and end != -1:
        flag = text[start:end + 1]
        print("\n[+] Flag:", flag)
    else:
        print("Flag format not found.")
else:
    print("[-] Ciphertext is not an exact cube.")


4. python mini_rsascript.py
