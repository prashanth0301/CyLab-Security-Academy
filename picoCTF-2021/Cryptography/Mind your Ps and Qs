from Crypto.Util.number import inverse, long_to_bytes

c = 717608817902276639011922897702552744324264244069272484013719744328086856277690292
n = 1368992139315019955067447961537607041364451719382349005056752379702694554965203011
e = 65537

p = 659880377875535146491994798968813949893149
q = 2074606527507983503944226222695401999839

# Verify RSA parameters
assert p * q == n
assert c < n

# Calculate private key
phi = (p - 1) * (q - 1)
d = inverse(e, phi)

# Decrypt ciphertext
m = pow(c, d, n)
raw = long_to_bytes(m)

print("Decrypted bytes:", raw)
print("Original output:", raw.decode("utf-8", errors="replace"))

# The plaintext is stored in reverse byte order
flag = raw[::-1].decode("utf-8")

print("Correct flag:", flag)

4. python valuesscript.py
```

