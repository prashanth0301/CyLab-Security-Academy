import string

ALPHABET = string.ascii_lowercase[:16]
ciphertext = "cbdabldadbplblcnpfpnpapapecpcn"

for key in ALPHABET:
    # Reverse the shift
    decoded = ""
    for c in ciphertext:
        index = (ord(c) - ord('a') - (ord(key) - ord('a'))) %>
        decoded += ALPHABET[index]

    # Decode pairs of 4-bit values into bytes
    try:
        raw = bytes(
            (ALPHABET.index(decoded[i]) << 4)
            | ALPHABET.index(decoded[i + 1])
            for i in range(0, len(decoded), 2)
        )
        print(f"Key {key}: {raw.decode('utf-8')}")
    except (UnicodeDecodeError, ValueError):
        pass

4. python new_caesar_script.py
```

