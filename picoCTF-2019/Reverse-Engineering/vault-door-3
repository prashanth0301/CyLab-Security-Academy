def decrypt(scrambled_str):
    # Initialize a blank list of 32 characters
    password = [''] * 32
    
    # Loop 1: Direct copy for indices 0 to 7
    for i in range(8):
        password[i] = scrambled_str[i]
        
    # Loop 2: Reverse mapping for indices 8 to 15
    for i in range(8, 16):
        password[23 - i] = scrambled_str[i]
        
    # Loop 3: Step-by-two mapping for even indices 16 to 30
    for i in range(16, 32, 2):
        password[46 - i] = scrambled_str[i]
        
    # Loop 4: Step-by-two mapping for odd indices 17 to 31
    for i in range(31, 16, -2):
        password[i] = scrambled_str[i]
        
    return "".join(password)

# The scrambled string inside the flag wrapper
scrambled_text = "jU5t_a_sna_3lpm16g84d_u_4_m7rc42"
unscrambled_text = decrypt(scrambled_text)

print(f"academy{{{unscrambled_text}}}")

4. python decrypt.py

```

