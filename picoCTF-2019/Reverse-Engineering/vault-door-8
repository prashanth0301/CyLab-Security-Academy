# Expected scrambled characters from VaultDoor8.java
expected = [
    0xF4, 0xC0, 0x97, 0xF0, 0x77, 0x97, 0xC0, 0xE4,
    0xF0, 0x77, 0xA4, 0xD0, 0xC5, 0x77, 0xF4, 0x86,
    0xD0, 0xA5, 0x45, 0x96, 0x27, 0xB5, 0x77, 0xD0,
    0xC1, 0xB4, 0xC0, 0xA5, 0xE0, 0xA5, 0xD0, 0xD0
]

# Swaps used by the Java scramble() function
swaps = [
    (1, 2), (0, 3), (5, 6), (4, 7),
    (0, 1), (3, 4), (2, 5), (6, 7)
]

def switch_bits(c, p1, p2):
    bit1 = (c >> p1) & 1
    bit2 = (c >> p2) & 1

    if bit1 != bit2:
        c ^= (1 << p1 ) | (1 << p2)

    return c
password = ""

for c in expected:
    # Reverse the swaps
    for p1, p2 in reversed(swaps):
        c = switch_bits(c, p1, p2)

    password += chr(c)

print("Password:", password)

4. python scrambledecode.py
    
```

### 🚀 Exploitation / Solution Path
# VaultDoor8 – Step-by-Step Guide to Get the Flag

1. Download `VaultDoor8.java` using the `wget` command.

2. Open the file using `nano` or any text editor.

3. Observe the `scramble()`, `switchBits()` and `checkPassword()` functions to understand how the password is scrambled using bit swapping and compared with the expected hexadecimal values.

4. Write a Python program named `scrambledecode.py` that stores the expected hexadecimal values and reverses the eight bit swaps in reverse order to recover the original password.

